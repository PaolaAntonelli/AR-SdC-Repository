  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In questa applicazione avrai la possibilit\xE0 di conoscere al meglio
    una struttura fondamentale: la trave doppiamente poggiata e caricata in mezzeria.
    Ti verra presentato uno schema che \xE8 possibile modificare spostando la posizione
    del carico e o degli appoggi. In pi\xF9 avrai l la possibilit\xE0 di conoscere
    la trave pi\xF9 volte appoggiata, un caso pi\xF9 complesso da analizzare."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d34d264dcbda534b839bd11366bfce8, type: 2}
