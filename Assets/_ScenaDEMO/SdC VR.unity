--- !u!114 &1214038756
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1214038754}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Pu\xF2 accadere che per una trave lineare possano esserci pi\xF9 di un
    appoggio e pi\xF9 di un carico.\nIn particolare nel primo caso, non appena si
    aggiungono pi\xF9 di due appoggi, si incorre in una struttura che viene detta
    \"iperstatica\". \nQuesto vuol dire che la traslazione e rotazione della trave
    \xE8 bloccata pi\xF9 volte e varia anche il valore delle reazioni che quindi
    agiscono in maniera differente su di essa. Usa la simulazione per vedere a quali
    nuove sollecitazioni \xE8 soggetta la trave."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d34d264dcbda534b839bd11366bfce8, type: 2}
  m_sharedMaterial: {fileID: 2119413175553802479, guid: 6d34d264dcbda534b839bd11366bfce8, type: 2}
